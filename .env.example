# Copy to .env (git-ignored) and fill in. Receipts never prints these values.
# Zetaris (local platform; REST API on :8888)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
# Meterless Nightshift runtime (OpenAI-compatible). The token is in Nightshift > Setup > Runtime.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
# Routing mode or a pinned model id served by Nightshift, e.g. nvidia/nemotron-3.5-lightning-30b-a3b
METERLESS_MODEL=meterless/auto
